# Configuration of the benchmark. harness/common.sh reads this file and then config/local.env (if it exists), so
# put your own values in config/local.env (it is not tracked by git). Every value can also be set in the environment.

# ROS 2 and Autoware. AUTOWARE_DIR is a built Autoware workspace (it has install/setup.bash).
: "${ROS_SETUP:=/opt/ros/jazzy/setup.bash}"
: "${AUTOWARE_DIR:=$HOME/autoware}"

# CUDA toolkit used to build the GPU options, and the GPU architecture to build for ("native" = the installed GPU).
: "${CUDA_HOME:=/usr/local/cuda-12.8}"
: "${CUDA_ARCHITECTURES:=native}"

# Where the data, the built workspaces and the results go.
: "${DATA_DIR:=$BENCH_ROOT/data}"
: "${WORKSPACES_DIR:=$BENCH_ROOT/workspaces}"
: "${RESULTS_DIR:=$BENCH_ROOT/results/runs}"

# ROS 2 isolation: the benchmark uses its own domain and stays on this computer.
: "${ROS_DOMAIN_ID:=87}"
: "${RMW_IMPLEMENTATION:=rmw_cyclonedds_cpp}"

# CPU pinning. Empty = automatic: the scan matcher gets the first 4 physical cores and their SMT siblings, everything
# else gets the other CPUs. Example for a 12-core, 24-thread CPU: NDT_CPUS=0-3,12-15 and OTHER_CPUS=4-11,16-23.
: "${NDT_CPUS:=}"
: "${OTHER_CPUS:=}"
: "${NDT_CORES:=4}"

From 089ff10849c5fe53eb84752b8243d2d43c3d24dc Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Mete=20Fatih=20C=C4=B1r=C4=B1t?= <mfc@autoware.org>
Date: Mon, 9 Nov 2026 17:16:11 +0300
Subject: [PATCH] feat(integrations/autoware): support the NDT interface of
 current Autoware
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Current autoware_ndt_scan_matcher passes the scan to align() as a
third argument and calls hasTarget(). Add both to the integration
header, so the package that apply.sh makes compiles again. They only
add members.

Signed-off-by: Mete Fatih Cırıt <mfc@autoware.org>
---
 .../ndt_scan_matcher/ndt_omp/multigrid_ndt_omp.h    | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/integrations/autoware/include/autoware/ndt_scan_matcher/ndt_omp/multigrid_ndt_omp.h b/integrations/autoware/include/autoware/ndt_scan_matcher/ndt_omp/multigrid_ndt_omp.h
index 967191f..6be046a 100644
--- a/integrations/autoware/include/autoware/ndt_scan_matcher/ndt_omp/multigrid_ndt_omp.h
+++ b/integrations/autoware/include/autoware/ndt_scan_matcher/ndt_omp/multigrid_ndt_omp.h
@@ -18,6 +18,19 @@ class MultiGridNormalDistributionsTransform
 {
 public:
   MultiGridNormalDistributionsTransform() { this->setUseAutowareCovariance(true); }
+
+  // Newer Autoware asks whether map tiles are loaded.
+  bool hasTarget() const { return !this->getCurrentMapIDs().empty(); }
+
+  // Newer Autoware passes the scan to align() instead of calling setInputSource().
+  using ndt_cuda::MultiGridNormalDistributionsTransformCUDA<PointSource, PointTarget>::align;
+  void align(
+    pcl::PointCloud<PointSource> & output, const Eigen::Matrix4f & guess,
+    const typename pcl::PointCloud<PointSource>::ConstPtr & source)
+  {
+    this->setInputSource(source);
+    this->align(output, guess);
+  }
 };
 }  // namespace pclomp
 

 include/ndt_cuda/gpu_backend.hpp   |  4 ++
 include/ndt_cuda/impl/ndt_cuda.hpp |  8 +++-
 include/ndt_cuda/ndt_cuda.hpp      |  3 +-
 integrations/autoware/README.md    |  2 +-
 src/gpu_backend.cu                 | 73 ++++++++++++++++++++++++------
